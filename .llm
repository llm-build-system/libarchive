type = "static-library"
name = "archive"
standards = ["C11"]

[registries]
official = "https://github.com/llm-build-system/llm-registry"

[dependencies]
private = ["official:openssl@3.5.9", "official:zlib@1.3.2", "official:bzip2@1.0.8", "official:xz@5.8.4", "official:zstd@1.5.7", "official:expat@2.9.0"]

[defines]
public = ["LIBARCHIVE_STATIC"]
private = ["HAVE_CONFIG_H", "__LIBARCHIVE_ENABLE_VISIBILITY"]

[windows]
libraries = ["advapi32", "bcrypt"]

[windows.includes]
private = ["config/windows"]

[windows.defines]
private = ["NOMINMAX", "_WIN32_WINNT=0x0A00", "_CRT_SECURE_NO_WARNINGS", "_CRT_NONSTDC_NO_DEPRECATE"]

[linux]
libraries = ["pthread", "dl"]

[linux.includes]
private = ["config/linux"]

[linux.defines]
private = ["_GNU_SOURCE"]

[macos]
libraries = ["pthread"]

[macos.includes]
private = ["config/macos"]

[macos.defines]
private = ["_DARWIN_C_SOURCE"]
